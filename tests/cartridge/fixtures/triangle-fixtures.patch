+
+    pub fn to_rdp_rgba8888(&self) -> u32 {
+        ((self.red() as u32) << 24)
+            | ((self.green() as u32) << 16)
+            | ((self.blue() as u32) << 8)
+            | self.alpha() as u32
+    }
+
+    pub fn from_rdp_rgba8888(value: u32) -> Self {
+        Self::new(
+            (value >> 24) as u8,
+            (value >> 16) as u8,
+            (value >> 8) as u8,
+            value as u8,
+        )
+    }
 }
 
