 pub struct ClockCPUvsRSP {}
 
+#[inline(never)]
+fn sample_clock_pair() -> (u32, u24) {
+    let cpu_clock: u32;
+    let rdp_clock: u32;
+    unsafe {
+        // A cache refill must happen before both samples, rather than between them.
+        // Reuse the same pair for the initial read and every later poll.
+        core::arch::asm!(
+            ".set push",
+            ".set noreorder",
+            ".balign 32",
+            "mfc0 {cpu_clock}, $9",
+            "lw {rdp_clock}, 0({rdp_address})",
+            ".set pop",
+            cpu_clock = out(reg) cpu_clock,
+            rdp_clock = out(reg) rdp_clock,
+            rdp_address = in(reg) 0xffff_ffff_a410_0010u64,
+            options(nostack),
+        );
+    }
+    (cpu_clock, u24::extract_u32(rdp_clock, 0))
+}
+
