option(CUPID_GROUP_CORE_TESTS "Link compatible checkpoint tests together with MSVC optimization" ON)

set(cupid_group_core_tests FALSE)
if(MSVC AND CUPID_INTERPROCEDURAL_OPTIMIZATION AND cupid_ipo_supported AND CUPID_GROUP_CORE_TESTS)
  set(cupid_group_core_tests TRUE)
  add_executable(core_checkpoint_tests tests/support/checkpoint_main.cpp)
  target_link_libraries(core_checkpoint_tests PRIVATE cupid_core)
endif()

function(cupid_add_core_test target entry main_source)
  if(cupid_group_core_tests)
    add_library(${target}_objects OBJECT ${main_source} ${ARGN})
    target_link_libraries(${target}_objects PRIVATE cupid_core)
    set_property(SOURCE ${main_source} APPEND PROPERTY COMPILE_DEFINITIONS main=${entry})
    target_sources(core_checkpoint_tests PRIVATE $<TARGET_OBJECTS:${target}_objects>)
    add_custom_target(${target} DEPENDS core_checkpoint_tests)
    set(${target}_command core_checkpoint_tests ${target} PARENT_SCOPE)
  else()
    add_executable(${target} ${main_source} ${ARGN})
    target_link_libraries(${target} PRIVATE cupid_core)
    set(${target}_command ${target} PARENT_SCOPE)
  endif()
endfunction()
