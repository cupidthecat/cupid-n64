option(CUPID_GROUP_CORE_TESTS "Link compatible test fixtures together with interprocedural optimization" ON)

set(cupid_group_core_tests FALSE)
if(CUPID_INTERPROCEDURAL_OPTIMIZATION AND cupid_ipo_supported AND CUPID_GROUP_CORE_TESTS)
  set(cupid_group_core_tests TRUE)
  add_executable(core_checkpoint_tests tests/support/checkpoint_main.cpp)
  target_link_libraries(core_checkpoint_tests PRIVATE cupid_core)
  add_executable(desktop_fixture_tests tests/support/dispatch/desktop.cpp)
  target_link_libraries(desktop_fixture_tests PRIVATE cupid_video_output)
  if(TARGET cupid_session)
    target_compile_definitions(desktop_fixture_tests PRIVATE CUPID_SESSION_TESTS)
    target_link_libraries(desktop_fixture_tests PRIVATE cupid_session)
  endif()
  if(TARGET cupid_renderer)
    add_executable(renderer_fixture_tests tests/support/dispatch/renderer.cpp)
    target_link_libraries(renderer_fixture_tests PRIVATE cupid_renderer)
  endif()
endif()

function(cupid_add_fixture_test target entry main_source)
  cmake_parse_arguments(PARSE_ARGV 3 fixture "" "GROUP;LIBRARY" "")
  if(NOT fixture_GROUP OR NOT fixture_LIBRARY)
    message(FATAL_ERROR "Test fixtures require a group and a library")
  endif()
  if(cupid_group_core_tests)
    add_library(${target}_objects OBJECT ${main_source} ${fixture_UNPARSED_ARGUMENTS})
    target_link_libraries(${target}_objects PRIVATE ${fixture_LIBRARY})
    set_property(SOURCE ${main_source} APPEND PROPERTY COMPILE_DEFINITIONS main=${entry})
    target_sources(${fixture_GROUP} PRIVATE $<TARGET_OBJECTS:${target}_objects>)
    add_custom_target(${target} DEPENDS ${fixture_GROUP})
    set(${target}_command ${fixture_GROUP} ${target} PARENT_SCOPE)
    set(${target}_compile_target ${target}_objects PARENT_SCOPE)
    set(${target}_link_target ${fixture_GROUP} PARENT_SCOPE)
  else()
    add_executable(${target} ${main_source} ${fixture_UNPARSED_ARGUMENTS})
    target_link_libraries(${target} PRIVATE ${fixture_LIBRARY})
    set(${target}_command ${target} PARENT_SCOPE)
    set(${target}_compile_target ${target} PARENT_SCOPE)
    set(${target}_link_target ${target} PARENT_SCOPE)
  endif()
endfunction()

function(cupid_add_core_test target entry main_source)
  cupid_add_fixture_test(${target} ${entry} ${main_source} ${ARGN}
    GROUP core_checkpoint_tests LIBRARY cupid_core)
  foreach(property command compile_target link_target)
    set(${target}_${property} ${${target}_${property}} PARENT_SCOPE)
  endforeach()
endfunction()
